&control
  nstep = 80
  forc_conv_thr = 2.0d-3
  etot_conv_thr = 2.0d-4
  calculation = 'relax'
  prefix = 'gas_H2'
  outdir = './tmp_gas_H2'
  pseudo_dir = '/gpfs-home/p230674mt/W3/SSSP_1.3.0_PBE_efficiency'
  tprnfor = .true.
  disk_io = 'low'
/
&system
  ibrav = 0
  nat = 2
  ntyp = 2
  ecutwfc = 40.0
  ecutrho = 200.0
  occupations = 'fixed'
/
&electrons
  conv_thr = 1.0e-06
  mixing_beta = 0.4
  electron_maxstep = 200
/
&ions
  ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
  H  1.008  H.pbe-rrkjus_psl.1.0.0.UPF
  O  15.999  O.pbe-n-kjpaw_psl.0.1.UPF
CELL_PARAMETERS angstrom
  14.000000  0.000000  0.000000
  0.000000  14.000000  0.000000
  0.000000  0.000000  14.000000
ATOMIC_POSITIONS angstrom
  H  6.625000  7.000000  7.000000  1 1 1
  H  7.375000  7.000000  7.000000  1 1 1

K_POINTS gamma
